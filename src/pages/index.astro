---
import { getCollection } from 'astro:content';
import { PILAR_META } from '../content/config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Marquee from '../components/Marquee.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import YouTubeFeed from '../components/YouTubeFeed.astro';
import depoimentos from '../data/depoimentos.json';
import { SITE, withBase, whatsappLink } from '../site';
import { Image } from 'astro:assets';
import { img } from '../lib/images';

const heroImg = img('aa-hero-ilustra');
const blocoImg = img('aa-normal-sala');
const mentoraImg = img('aa-retrato-aline');
const gifHands = withBase('/img/gif-hands-yinyang.webp');
const gifSun = withBase('/img/gif-sun.webp');

const whatsappConhecer = whatsappLink('Oi, Aline. Vim pelo site e gostaria de conhecer melhor a sua forma de trabalhar.');

const depoDestaque = depoimentos.filter((d) => d.destaque).slice(0, 4);

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pilares = Object.entries(PILAR_META)
  .filter(([nome]) => nome !== 'Arcanos')
  .map(([nome, meta]) => ({ nome, desc: meta.desc, slug: meta.slug, img: img(meta.img), alt: meta.alt }));

const virtudes = ['Lucidez', 'Honestidade', 'Liberdade', 'Autovalor', 'Sobriedade', 'Autenticidade', 'Criatividade', 'Compaixão', 'Integridade', 'Autonomia', 'Coragem', 'Presença'];

const site = Astro.site ?? new URL('https://alineantunes.site');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Aline Antunes',
    url: site.href,
    inLanguage: 'pt-BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Aline Antunes',
    jobTitle: 'Terapeuta de maturidade e autonomia emocional',
    url: site.href,
    description:
      'Terapeuta que trabalha maturidade e autonomia emocional, individuação e rompimento de padrões repetitivos, usando o Tarô como ferramenta de consciência.',
    sameAs: ['https://instagram.com/alinea.antunes', SITE.youtube],
  },
];
---
<BaseLayout jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero bg-blush">
    <div class="wrap hero-grid">
      <figure class="hero-media hero-media--art" data-reveal>
        {heroImg ? (
          <Image
            src={heroImg}
            alt="Ilustração de uma mulher serena regando flores que brotam da própria cabeça"
            widths={[360, 560, 840]}
            sizes="(max-width: 860px) 70vw, 28vw"
            format="webp"
            quality={80}
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="hero-fallback" role="img" aria-label="Luz quente"><span class="hero-spark" aria-hidden="true">✦</span></div>
        )}
      </figure>
      <div class="hero-copy center">
        <span class="eyebrow" data-reveal>para pessoas que (sobre)vivem às suas feridas e ao passado</span>
        <h1 data-reveal style="--reveal-delay:80ms">Antes de uma nova vida, a vida precisa voltar a criar.</h1>
        <p class="sub" data-reveal style="--reveal-delay:160ms">É comum passarmos anos tentando mudar aquilo que faz barulho, enquanto permanece invisível o que continua impedindo a vida de criar novas possibilidades.</p>
        <div class="actions" data-reveal style="--reveal-delay:240ms">
          <a href={withBase("/atendimentos/taro-terapeutico")} class="btn btn-gold">Agendar uma consulta</a>
          <a href={withBase("/blog")} class="btn btn-ghost">Ler o blog</a>
        </div>
      </div>
      <figure class="hero-gif" data-reveal style="--reveal-delay:120ms" aria-hidden="true">
        <img src={gifHands} alt="" width="300" height="213" loading="eager" decoding="async" />
      </figure>
    </div>
  </section>

  <!-- Faixa marquee (corrimão de palavras) -->
  <Marquee items={['Lucidez', 'Autenticidade', 'Liberdade', 'Autovalor', 'Autonomia emocional', 'Criatividade']} />

  <!-- Bloco "Você aprendeu a sobreviver" (substitui o antigo bloco marrom) -->
  <section class="section bg-wheat sobreviver-sec">
    <div class="read center">
      <div class="stanza" data-reveal>
        <p class="strong-line">Você aprendeu a sobreviver.</p>
        <p>A sobreviver às expectativas.</p>
        <p>Às histórias dolorosas que continuaram se acumulando ao longo da vida.</p>
        <p>Às situações que exigiram que você se adaptasse para seguir em frente.</p>
        <p>Às versões de si mesma(o) que precisou criar para ser aceita(o), amada(o) ou reconhecida(o).</p>
      </div>
      <p class="aside-line" data-reveal style="--reveal-delay:120ms">Mas talvez exista uma pergunta mais importante:<br />Quanto de você ficou pelo caminho?</p>
      <div class="questions" data-reveal style="--reveal-delay:160ms">
        <p>Percebe que certas histórias continuam se repetindo, mesmo quando você tenta fazer diferente?</p>
        <p>Já se perguntou por que algumas áreas da sua vida avançam enquanto outras parecem presas aos mesmos ciclos?</p>
        <p>E se a questão não estivesse apenas nos padrões?</p>
        <p>E se estivesse nos lugares onde você aprendeu a se afastar de si mesma(o)? Nos acordos silenciosos que fez para manter vínculos. Nas partes de você que foram sendo deixadas de lado para garantir amor, aceitação ou segurança.</p>
      </div>
      <p class="aside-line" data-reveal>… estou chegando perto?</p>
      <p class="questions q-close" data-reveal>Perto da forma como você aprendeu a duvidar de si. A minimizar suas necessidades. A negociar seus limites. A buscar fora aquilo que só pode ser reconstruído dentro.</p>
      <p class="strong-line closing" data-reveal>Então você está no lugar certo.</p>
    </div>
  </section>

  <!-- Bloco two-tone com imagem + GIF do sol -->
  <section class="two-tone normal-sec" style="--tt-a: color-mix(in srgb, #6E8B3D 55%, #fff); --tt-b: #EED2EE;">
    <div class="wrap split-grid">
      <figure class="split-media" data-reveal>
        {blocoImg && (
          <Image src={blocoImg} alt="Sala de estar aconchegante, em tons terrosos e luz quente" widths={[480, 720, 960]} sizes="(max-width: 860px) 88vw, 44vw" format="webp" quality={72} loading="lazy" />
        )}
      </figure>
      <div class="normal-copy" data-reveal style="--reveal-delay:100ms">
        <img class="sun-seal" src={gifSun} alt="" aria-hidden="true" width="180" height="128" loading="lazy" decoding="async" />
        <p class="ego-lead"><strong>Toda vida possui uma força autocriativa. Ela é a capacidade de criar novos caminhos, novas escolhas e novas formas de existir. Quando essa força se aprisiona em padrões, medos, vínculos ou histórias que já não correspondem a quem você é, a vida continua — mas deixa de criar novas possibilidades. É desse lugar que nasce o meu trabalho.</strong></p>
        <p>A sessão é um convite para reconhecer onde o movimento da sua vida foi interrompido. Não para encontrar respostas prontas, mas para tornar visíveis as estruturas que aprisionam a sua força autocriativa. O Tarô entra como linguagem simbólica, ampliando aquilo que a consciência ainda não consegue nomear.</p>
        <p>Porque a interrupção do movimento da vida não se desfaz apenas quando algo é compreendido, mas quando você se torna capaz de sustentar a verdade sobre si mesma — inclusive suas contradições — sem fugir, sem se justificar e sem se condenar. É nesse espaço que a força autocriativa volta a encontrar passagem.</p>
        <a href={withBase("/atendimentos/taro-terapeutico")} class="btn btn-gold">Agendar uma consulta</a>
      </div>
    </div>
  </section>

  <!-- Bloco "Mentora de transformação pessoal" -->
  <section class="section bg-sand mentora-sec">
    <div class="wrap split-grid rev">
      <figure class="split-media" data-reveal>
        {mentoraImg && (
          <Image src={mentoraImg} alt="Retrato de Aline Antunes, ruiva, apoiando o queixo na mão" widths={[420, 620, 840]} sizes="(max-width: 860px) 80vw, 40vw" format="webp" quality={74} loading="lazy" />
        )}
      </figure>
      <div class="mentora-copy" data-reveal style="--reveal-delay:100ms">
        <p class="mentora-sub">Mentora de transformação pessoal, educadora emocional</p>
        <p class="mentora-bio">(Movida por perguntas sobre a alma humana nas horas vagas. E nas horas ocupadas também. Mãe de um dog. Casada com o meu companheiro de vida. Encantada pelas miudezas despercebidas. Meu arcano preferido é O Louco — amanhã não sei!)</p>
        <p>A maioria das pessoas que chegam até mim já percorreu um longo caminho. Leram livros, fizeram cursos, buscaram diferentes formas de terapia e desenvolveram uma boa compreensão sobre si mesmas. Ainda assim, algo permanece estagnado. Elas entendem os próprios padrões, reconhecem as feridas que carregam e conseguem explicar com clareza o que vivem. Mas continuam sem conseguir criar o que mais desejam: um relacionamento diferente, uma decisão importante, uma nova forma de viver, uma relação mais livre consigo mesmas.</p>
        <p>Foi convivendo com essas histórias — e com a minha própria — que comecei a perceber algo que transformou a maneira como compreendo o desenvolvimento humano. Ao longo da minha trajetória, transitei pela tarologia, pelos estudos de desenvolvimento humano, processos de individuação com Jung, alquimia profunda, alta magia, pela Gestalt-terapia e filosofias. E foi na prática, acompanhando pessoas e vivenciando e observando os meus próprios processos, que uma pergunta passou a orientar todo o meu trabalho: o que faz com que a vida deixe de criar?</p>
        <p>Hoje compreendo que, por trás de sintomas diferentes, muitas vezes existe a mesma interrupção. A força autocriativa continua presente, mas encontra-se aprisionada em padrões, medos, vínculos, expectativas ou antigas estratégias de sobrevivência. A vida segue acontecendo, mas perde a capacidade de criar novas possibilidades.</p>
        <p>É por isso que meu trabalho não se concentra apenas na queixa que trouxe você até aqui. Ele busca reconhecer onde o movimento da sua vida foi interrompido. A terapia sustenta esse processo de reconhecimento, e o Tarô participa dele como linguagem simbólica, tornando visível aquilo que muitas vezes ainda não encontrou palavras.</p>
        <p>Não acredito em fórmulas prontas nem em transformações instantâneas. Acredito que toda pessoa possui uma força autocriativa capaz de renovar a própria existência. Às vezes ela está silenciosa. Às vezes parece distante. Mas ela não desaparece. Meu trabalho é ajudar você a reconhecer o que interrompeu esse movimento para que, pouco a pouco, essa força volte a encontrar passagem.</p>
        <p>Se você sente que chegou o momento de compreender a si mesma com mais profundidade, recuperar a autoria sobre a própria vida e abrir espaço para novas possibilidades, seja bem-vinda(o).</p>
      </div>
    </div>
  </section>

  <!-- As virtudes do nosso crescimento -->
  <section class="section virtudes-sec" style="background: color-mix(in srgb, #6E8B3D 55%, #fff);">
    <div class="wrap center">
      <h2 data-reveal>Virtudes que direcionam o meu trabalho</h2>
      <ul class="virtudes" data-reveal style="--reveal-delay:80ms">
        {virtudes.map((v) => <li>{v}</li>)}
      </ul>
      <p class="virtudes-fecho" data-reveal style="--reveal-delay:160ms">As respostas podem iluminar o caminho. Mas são as virtudes que nos permitem percorrê-lo.</p>
    </div>
  </section>

  <!-- Pilares (blog por território) -->
  <section class="wrap section pilares-sec" style="background:#A0522D;">
    <div class="center" data-reveal>
      <span class="eyebrow">O blog por território</span>
      <h2>Seis territórios para ler e se olhar</h2>
      <p class="muted pilares-sub">Os artigos do blog, organizados por território de trabalho. Escolha por onde começar a leitura.</p>
    </div>
    <div class="card-grid pilares" data-reveal>
      {pilares.map((p) => (
        <a class="card pilar-card" href={withBase(`/blog/pilar/${p.slug}`)}>
          {p.img && (
            <span class="pilar-thumb">
              <Image src={p.img} alt={p.alt} widths={[320, 480]} sizes="(max-width: 600px) 90vw, 340px" format="webp" quality={62} loading="lazy" />
            </span>
          )}
          <span class="badge">Pilar</span>
          <h3>{p.nome}</h3>
          <p class="hook">{p.desc}</p>
          <span class="more">Ver o pilar <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <!-- Depoimentos -->
  <section class="wrap section depo-sec" style="background:#FFA07A;">
    <div class="center" data-reveal>
      <span class="eyebrow">Depoimentos</span>
      <h2>O que dizem as clientes</h2>
    </div>
    <div class="depo-wrap" data-reveal>
      <Depoimentos items={depoDestaque} />
    </div>
  </section>

  <!-- Ferramenta gratuita: Descubra seu Arcano -->
  <section class="wrap section">
    <div class="arcano-banner glow" data-reveal>
      <div class="arcano-txt">
        <span class="eyebrow">Gratuito</span>
        <h2>Descubra seu Arcano Pessoal e do Ano</h2>
        <p class="muted">Uma porta de entrada para o simbólico. Descubra a carta que fala de quem você é e do momento que você está vivendo, e o que ela tem pra te mostrar.</p>
      </div>
      <a class="btn btn-gold" href={SITE.arcanoApp} target="_blank" rel="noopener">Descobrir meu arcano →</a>
    </div>
  </section>

  <!-- Instagram -->
  <section class="wrap section bg-blush">
    <div class="center" data-reveal>
      <span class="eyebrow">No Instagram</span>
      <h2>Esteja comigo nas redes sociais</h2>
    </div>
    <div class="ig-home" data-reveal>
      <InstagramFeed />
    </div>
  </section>

  <!-- YouTube -->
  <section class="wrap section">
    <div class="center" data-reveal>
      <span class="eyebrow">No YouTube</span>
      <h2>Aulas e conversas</h2>
    </div>
    <div class="yt-home" data-reveal>
      <YouTubeFeed />
    </div>
  </section>

  <!-- Como saber se sou a profissional certa para você? -->
  <section class="section bg-salmon profissional-sec">
    <div class="read center">
      <div data-reveal>
        <span class="eyebrow">Antes de começar</span>
        <h2>Como saber se sou a profissional certa para você?</h2>
      </div>
      <div class="prof-body" data-reveal style="--reveal-delay:100ms">
        <p>Antes de qualquer compromisso, você pode compartilhar o que está vivendo, fazer perguntas e conhecer melhor minha forma de trabalhar. Eu também poderei entender suas necessidades e perceber se realmente posso contribuir com sua jornada.</p>
        <p>Nem todo profissional é a escolha certa para todas as pessoas. O mais importante é encontrar alguém com quem você se sinta seguro para explorar, questionar e transformar aquilo que precisa ser transformado.</p>
        <p>Ficarei feliz em apresentar o meu trabalho.</p>
      </div>
      <div data-reveal style="--reveal-delay:160ms"><a href={whatsappConhecer} class="btn btn-gold" rel="noopener">Me chame no WhatsApp</a></div>
    </div>
  </section>

  <!-- CTA final (seção-âncora escura) -->
  <section class="section anchor oxblood cta-sec">
    <div class="read center">
      <p class="rule" aria-hidden="true"><span class="sparkle">✦</span></p>
      <h2 data-reveal>Quer dar o primeiro passo?</h2>
      <p class="muted" data-reveal style="--reveal-delay:100ms">A sessão é uma conversa de clareza, não de previsão. Você sai entendendo o padrão e com algo concreto para fazer com isso.</p>
      <div data-reveal style="--reveal-delay:180ms"><a href={withBase("/atendimentos/taro-terapeutico")} class="btn btn-gold">Agendar uma consulta</a></div>
    </div>
  </section>
</BaseLayout>
<style>
  /* ---- Hero (imagem à esquerda · texto ao centro · gif giratório à direita) ---- */
  .hero { padding-block: var(--s9); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: .8fr 1.1fr .6fr; gap: var(--s7); align-items: center; }
  .hero h1 { font-size: clamp(2.3rem, 5vw, 3.6rem); margin: var(--s4) 0; }
  .hero .eyebrow { font-style: italic; text-transform: none; letter-spacing: .02em; font-weight: 500; font-size: .98rem; color: var(--ink-soft); font-family: var(--font-serif); }
  .sub { font-size: 1.12rem; color: var(--ink-soft); max-width: 46ch; margin-inline: auto; }
  .actions { display: flex; gap: var(--s4); margin-top: var(--s6); flex-wrap: wrap; justify-content: center; }

  .hero-media { margin: 0; }
  .hero-media :global(img) {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 28% center;
    border-radius: 18px; box-shadow: 0 30px 70px -36px color-mix(in srgb, var(--ink) 70%, transparent);
  }
  /* Quando o hero é uma ilustração (PNG transparente): sem moldura, sem recorte. */
  .hero-media--art :global(img) {
    aspect-ratio: auto; object-fit: contain; border-radius: 0; box-shadow: none;
    background: transparent; width: 100%; height: auto; max-height: 480px; margin-inline: auto;
  }
  .hero-gif { margin: 0; display: grid; place-items: center; }
  .hero-gif img { width: 100%; max-width: 257px; height: auto; mix-blend-mode: multiply; }
  .hero-fallback {
    position: relative; width: 100%; aspect-ratio: 4 / 5; border-radius: 18px; border: 1px solid var(--line);
    background: radial-gradient(60% 60% at 50% 38%, color-mix(in srgb, var(--amber) 32%, transparent), transparent 70%), linear-gradient(160deg, var(--paper-2), var(--paper-3));
    display: grid; place-items: center; overflow: hidden;
  }
  .hero-spark { font-size: clamp(4rem, 12vw, 8rem); color: var(--gold-soft); opacity: .9; }

  @media (max-width: 860px) {
    /* No celular: imagem (esq.) e GIF (dir.) lado a lado; texto embaixo. */
    .hero { padding-block: var(--s8) var(--s7); }
    .hero-grid { grid-template-columns: 1fr 1fr; gap: var(--s5) var(--s4); align-items: center; }
    .hero-media { grid-column: 1; grid-row: 1; order: 1; max-width: 100%; margin-inline: auto; }
    .hero-gif { grid-column: 2; grid-row: 1; order: 2; align-self: center; }
    .hero-copy { grid-column: 1 / -1; grid-row: 2; order: 3; }
    .hero-gif img { max-width: 207px; }
    .hero-media :global(img) { aspect-ratio: 5 / 4; }
    .hero-media--art :global(img) { aspect-ratio: auto; max-height: 320px; }
  }

  /* ---- Bloco "Você aprendeu a sobreviver" ---- */
  .stanza p { margin: 0 0 var(--s2); font-family: var(--font-serif); font-size: 1.18rem; line-height: 1.5; color: var(--ink-soft); }
  .stanza.tight p { margin-bottom: var(--s1); }
  .strong-line { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.5rem, 3.4vw, 2.1rem); line-height: 1.25; color: var(--ink); margin: 0 0 var(--s3); }
  .sobreviver-sec .questions { max-width: 60ch; margin: var(--s6) auto 0; }
  .sobreviver-sec .questions p { font-size: 1.12rem; color: var(--ink); margin-bottom: var(--s4); }
  .sobreviver-sec .aside-line { font-family: var(--font-serif); font-style: italic; font-size: 1.3rem; color: var(--wine); margin: var(--s6) 0 var(--s3); }
  .sobreviver-sec .q-close { max-width: 56ch; margin-inline: auto; }
  .sobreviver-sec .closing { margin-top: var(--s6); color: var(--gold); }

  /* ---- Bloco two-tone "viver dessa forma parece normal" ---- */
  .normal-sec { padding-block: var(--s9); }
  .normal-copy .sun-seal { width: 84px; height: auto; margin-bottom: var(--s4); mix-blend-mode: multiply; }
  .normal-copy { font-size: 1.06rem; }
  .normal-copy p { color: var(--ink-soft); }
  .lead-line { font-size: clamp(1.6rem, 3.6vw, 2.2rem) !important; color: var(--ink) !important; margin-bottom: var(--s5); }
  .ego-lead { font-size: clamp(1.18rem, 2.4vw, 1.4rem); line-height: 1.45; margin-bottom: var(--s5); }
  .ego-lead strong { color: var(--ink); font-weight: 600; }
  .normal-copy .stanza p { font-size: 1.12rem; color: var(--ink-soft); }
  .normal-copy .btn { margin-top: var(--s4); }

  /* ---- Bloco Mentora ---- */
  .mentora-copy { font-size: 1.04rem; }
  .mentora-copy p { color: var(--ink-soft); }
  .mentora-sub { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.4rem, 3vw, 1.85rem); line-height: 1.3; color: var(--ink) !important; margin-bottom: var(--s4); }
  .mentora-bio { font-family: var(--font-serif); font-style: italic; color: var(--wine) !important; font-size: 1.06rem; }
  .mentora-copy strong { color: var(--ink); font-weight: 600; }

  /* ---- As virtudes ---- */
  .virtudes-sec h2 { margin-top: 0; color: var(--ink); }
  .virtudes { list-style: none; padding: 0; margin: var(--s7) auto; max-width: 880px; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s4) var(--s7); }
  .virtudes li { font-family: var(--font-label); font-weight: 700; font-size: .92rem; letter-spacing: .16em; text-transform: uppercase; color: var(--ink); }
  .virtudes-fecho { font-family: var(--font-serif); font-style: italic; font-size: 1.25rem; line-height: 1.5; color: color-mix(in srgb, var(--ink) 72%, transparent); max-width: 46ch; margin-inline: auto; }

  /* Pilares sobre sienna (#A0522D) */
  .pilares-sec .eyebrow { color: #f3d9c8; }
  .pilares-sec h2, .pilares-sec .muted { color: #fdf3ec; }
  .pilares-sec .pilar-card { background: color-mix(in srgb, #fff 12%, transparent); border-color: color-mix(in srgb, #fff 20%, transparent); }
  .pilares-sec .pilar-card h3 { color: #fdf3ec; }
  .pilares-sec .pilar-card .hook { color: color-mix(in srgb, #fdf3ec 75%, transparent); }
  .pilares-sec .pilar-card .more { color: #fbe3d6; }

  /* Depoimentos sobre #FFA07A */
  .depo-sec .eyebrow { color: color-mix(in srgb, var(--ink) 70%, transparent); }
  .depo-sec h2 { color: var(--ink); }

  /* ---- Profissional certa ---- */
  .profissional-sec h2 { margin-top: 0; }
  .prof-body { margin: var(--s6) 0; }
  .prof-body p { font-size: 1.12rem; color: var(--ink); }

  /* ---- Reaproveitados ---- */
  .pilares { margin-top: var(--s7); }
  .depo-wrap, .ig-home, .yt-home { margin-top: var(--s7); }
  .pilares-sub { max-width: 56ch; margin: var(--s4) auto 0; }
  .pilar-card { display: flex; flex-direction: column; color: var(--ink); overflow: hidden; }
