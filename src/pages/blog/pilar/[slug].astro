---
import { getCollection } from 'astro:content';
import { PILAR_META } from '../../../content/config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../site';
import ArticleCard from '../../../components/ArticleCard.astro';
import { Image } from 'astro:assets';
import { img } from '../../../lib/images';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  // Arcanos tem página própria em /blog/arcanos; aqui só os 6 pilares editoriais.
  return Object.entries(PILAR_META)
    .filter(([nome]) => nome !== 'Arcanos')
    .map(([nome, meta]) => ({
      params: { slug: meta.slug },
      props: {
        nome,
        meta,
        posts: posts
          .filter((p) => p.data.pilar === nome)
          .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
      },
    }));
}

const { nome, meta, posts } = Astro.props;
const pilarImg = img(meta.img);
---
<BaseLayout
  title={`${nome} | Blog da Aline Antunes`}
  description={meta.desc}
>
  <section class="section glow">
    <div class="wrap pilar-head">
      <div class="pilar-copy">
        <p class="trail"><a href={withBase("/blog")}>Blog</a> <span aria-hidden="true">›</span> Pilar</p>
        <span class="eyebrow" data-reveal>Pilar</span>
        <h1 data-reveal style="--reveal-delay:80ms">{nome}</h1>
        <p class="lead" data-reveal style="--reveal-delay:140ms">{meta.intro}</p>
      </div>
      {pilarImg && (
        <figure class="pilar-img" data-reveal style="--reveal-delay:120ms">
          <Image src={pilarImg} alt={meta.alt} widths={[360, 520, 640]} sizes="(max-width: 820px) 70vw, 34vw" format="webp" quality={72} loading="eager" />
        </figure>
      )}
    </div>
  </section>

  <section class="wrap">
    <div class="card-grid" data-reveal>
      {posts.map((p) => (
        <ArticleCard href={withBase(`/blog/${p.slug}`)} titulo={p.data.titulo} hook={p.data.hook} pilar={p.data.pilar} arcano={p.data.arcano} />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="read center cta">
      <p class="rule" aria-hidden="true"><span class="sparkle">✦</span></p>
      <p class="muted">Esses padrões aparecem na sua vida? A sessão é o lugar de olhar o seu.</p>
      <div class="cta-actions">
        <a href={withBase("/atendimentos/taro-terapeutico")} class="btn btn-gold">Agendar uma sessão</a>
        <a href={withBase("/blog")} class="btn btn-ghost">Voltar ao blog</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .trail { font-size: .9rem; color: var(--ink-soft); margin-bottom: var(--s3); }
  .trail a { color: var(--ink-soft); }
  .trail a:hover { color: var(--gold); }
  .pilar-head { display: grid; grid-template-columns: 1.15fr .85fr; gap: var(--s8); align-items: center; }
  .pilar-img { margin: 0; }
  .pilar-img :global(img) { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 18px; box-shadow: var(--shadow-soft); }
  @media (max-width: 820px) {
    .pilar-head { grid-template-columns: 1fr; gap: var(--s6); }
    .pilar-img { order: -1; max-width: 380px; }
  }
  .lead { font-family: var(--font-display); font-style: italic; font-weight: 420; font-size: clamp(1.35rem, 2.8vw, 1.7rem); line-height: 1.4; color: var(--wine); margin-top: var(--s5); }
  .cta { padding: var(--s8) var(--s5) 0; }
  .cta .rule { margin-top: 0; }
  .cta .muted { margin-bottom: var(--s5); }
  .cta-actions { display: flex; gap: var(--s4); justify-content: center; flex-wrap: wrap; }
  @media (max-width: 600px) { .cta-actions .btn { width: 100%; justify-content: center; } }
</style>
