---
import { getCollection } from 'astro:content';
import { PILARES, pilarSlug } from '../../content/config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { Image } from 'astro:assets';
import { img } from '../../lib/images';

const header = img('aa-blog-header');

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pilares = PILARES.filter((p) => p !== 'Arcanos');
const arcanos = posts
  .filter((p) => p.data.pilar === 'Arcanos')
  .sort((a, b) => (a.data.numeroArcano ?? 0) - (b.data.numeroArcano ?? 0));
---
<BaseLayout title="Blog · Aline Antunes" description="Artigos sobre maturidade emocional, padrões repetitivos, individuação e o Tarô como espelho. Material autoral e profundo.">
  <section class={`page-hero ${header ? 'has-img' : 'glow'}`}>
    {header && (
      <div class="ph-bg" aria-hidden="true">
        <Image src={header} alt="" widths={[768, 1200, 1600]} sizes="100vw" format="webp" quality={70} loading="eager" />
      </div>
    )}
    <div class="read center ph-content">
      <span class="eyebrow" data-reveal>Blog</span>
      <h1 data-reveal style="--reveal-delay:80ms">Textos para quem quer se olhar de verdade</h1>
      <p class="muted lead-sub" data-reveal style="--reveal-delay:140ms">Material autoral, sem fórmula pronta. Organizado por pilares de trabalho e pela série A Jornada do Louco no Tarot.</p>
    </div>
  </section>

  {pilares.map((pilar) => {
    const list = posts.filter((p) => p.data.pilar === pilar);
    if (list.length === 0) return null;
    return (
      <section class="wrap pilar-block">
        <div class="block-head" data-reveal>
          <h2><a href={`/blog/pilar/${pilarSlug(pilar)}`}>{pilar}</a></h2>
          <a class="see-all" href={`/blog/pilar/${pilarSlug(pilar)}`}>Ver o pilar <span aria-hidden="true">→</span></a>
        </div>
        <div class="card-grid" data-reveal>
          {list.map((p) => (
            <ArticleCard href={`/blog/${p.slug}`} titulo={p.data.titulo} hook={p.data.hook} pilar={p.data.pilar} arcano={p.data.arcano} />
          ))}
        </div>
      </section>
    );
  })}

  {arcanos.length > 0 && (
    <section class="wrap pilar-block">
      <div class="block-head" data-reveal>
        <h2><a href="/blog/arcanos">Série · A Jornada do Louco no Tarot</a></h2>
        <a class="see-all" href="/blog/arcanos">Ver a série em ordem <span aria-hidden="true">→</span></a>
      </div>
      <p class="muted intro" data-reveal>Cada carta, uma etapa do amadurecimento. Cada arcano, uma figura cultural e um padrão humano. O Tarô como espelho, não como futuro.</p>
      <div class="card-grid" data-reveal>
        {arcanos.map((p) => (
          <ArticleCard href={`/blog/${p.slug}`} titulo={p.data.titulo} hook={p.data.hook} pilar={p.data.pilar} arcano={p.data.arcano} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
<style>
  .lead-sub { max-width: 56ch; margin-inline: auto; font-size: 1.12rem; }
  .pilar-block { margin-top: var(--s9); }
  .block-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s4); margin-bottom: var(--s6); padding-bottom: var(--s3); border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .block-head h2 { margin: 0; }
  .block-head h2 a { color: var(--ink); border: 0; }
  .block-head h2 a:hover { color: var(--gold); }
  .see-all { display: inline-flex; align-items: center; gap: .4em; font-family: var(--font-sans); font-size: .9rem; font-weight: 600; color: var(--gold); border: 0; white-space: nowrap; }
  .see-all span { transition: transform .2s var(--ease); }
  .see-all:hover { color: var(--ink); }
  .see-all:hover span { transform: translateX(4px); }
  .intro { max-width: 60ch; margin-top: calc(-1 * var(--s4)); margin-bottom: var(--s6); }
  @media (prefers-reduced-motion: reduce) { .see-all:hover span { transform: none; } }
</style>
