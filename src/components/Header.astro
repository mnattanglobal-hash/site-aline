---
import { SITE } from '../site';
const links = [
  { href: '/', label: 'Início' },
  { href: '/sobre', label: 'Sobre' },
  {
    href: '/atendimentos',
    label: 'Atendimentos',
    children: [
      { href: '/atendimentos/taro-terapeutico', label: 'Tarot Terapêutico' },
      { href: '/atendimentos/terapia', label: 'Terapia' },
    ],
  },
  { href: '/cursos', label: 'Cursos' },
  { href: '/blog', label: 'Blog' },
  { href: '/contato', label: 'Contato' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Aline Antunes, página inicial">
      <span class="brand-name">Aline Antunes</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-principal" aria-label="Abrir menu">
      <svg class="i-menu" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M3.5 7h17M3.5 12h17M3.5 17h17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
      <svg class="i-close" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M5.5 5.5l13 13M18.5 5.5l-13 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
    <nav id="nav-principal" aria-label="Principal">
      <div class="nav-pages">
        {links.map((l) => (
          l.children ? (
            <div class="nav-group">
              <a href={l.href} class:list={['navlink', 'nav-group-trigger', { active: isActive(l.href) }]} aria-haspopup="true">
                {l.label}
                <svg class="nav-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M5 9l7 7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <div class="nav-submenu">
                {l.children.map((c) => (
                  <a href={c.href} class:list={['navlink', 'nav-sublink', { active: isActive(c.href) }]}>{c.label}</a>
                ))}
              </div>
            </div>
          ) : (
            <a href={l.href} class:list={['navlink', { active: isActive(l.href) }]}>{l.label}</a>
          )
        ))}
        <a href={SITE.arcanoApp} class="navlink nav-arcano" target="_blank" rel="noopener">Descubra seu Arcano</a>
      </div>
      <div class="nav-social">
        <a href={SITE.youtube} class="social" target="_blank" rel="noopener" aria-label="Canal no YouTube">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.11-2.13C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.39.52A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.11 2.13c1.89.52 9.39.52 9.39.52s7.5 0 9.39-.52a3 3 0 0 0 2.11-2.13A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg>
        </a>
        <a href={SITE.instagram} class="social" target="_blank" rel="noopener" aria-label="Perfil no Instagram">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 1.62c-3.15 0-3.5.01-4.74.07-1.14.05-1.76.24-2.17.4-.55.21-.94.47-1.35.88-.41.41-.67.8-.88 1.35-.16.41-.35 1.03-.4 2.17-.06 1.24-.07 1.59-.07 4.74s.01 3.5.07 4.74c.05 1.14.24 1.76.4 2.17.21.55.47.94.88 1.35.41.41.8.67 1.35.88.41.16 1.03.35 2.17.4 1.24.06 1.59.07 4.74.07s3.5-.01 4.74-.07c1.14-.05 1.76-.24 2.17-.4.55-.21.94-.47 1.35-.88.41-.41.67-.8.88-1.35.16-.41.35-1.03.4-2.17.06-1.24.07-1.59.07-4.74s-.01-3.5-.07-4.74c-.05-1.14-.24-1.76-.4-2.17a3.6 3.6 0 0 0-.88-1.35 3.6 3.6 0 0 0-1.35-.88c-.41-.16-1.03-.35-2.17-.4-1.24-.06-1.59-.07-4.74-.07Zm0 2.76a5.3 5.3 0 1 1 0 10.6 5.3 5.3 0 0 1 0-10.6Zm0 1.62a3.68 3.68 0 1 0 0 7.36 3.68 3.68 0 0 0 0-7.36Zm5.48-2.88a1.24 1.24 0 1 1 0 2.48 1.24 1.24 0 0 1 0-2.48Z"/></svg>
        </a>
      </div>
      <a href="/atendimentos/taro-terapeutico" class="btn btn-gold nav-cta">Agendar sessão</a>
    </nav>
    <div class="nav-scrim" data-nav-scrim hidden></div>
  </div>
</header>
<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    position: sticky; top: 0; z-index: 30;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; padding-block: var(--s4); gap: var(--s5); }
  .brand { display: inline-flex; align-items: center; gap: .55em; color: var(--ink); border: 0; }
  .brand-mark { color: var(--gold); font-size: 1.05rem; transition: transform .4s var(--ease); font-variant-emoji: text; }
  .brand:hover .brand-mark { transform: rotate(90deg); }
  .brand-name { font-family: var(--font-display); font-size: 1.35rem; font-weight: 500; letter-spacing: -0.01em; text-transform: lowercase; }

  nav { display: flex; align-items: center; gap: var(--s5); flex-wrap: wrap; }
  .nav-pages { display: flex; align-items: center; gap: var(--s5); flex-wrap: wrap; }
  .navlink { position: relative; color: var(--ink-soft); border: 0; font-size: .95rem; text-transform: lowercase; padding-block: 2px; }
  .navlink::after { content: ''; position: absolute; left: 0; right: 100%; bottom: -2px; height: 1px; background: var(--gold-soft); transition: right .25s var(--ease); }
  .navlink:hover { color: var(--gold); }
  .navlink:hover::after { right: 0; }
  .navlink.active { color: var(--ink); font-weight: 600; }
  .navlink.active::after { right: 0; }

  .nav-social { display: flex; align-items: center; gap: var(--s3); }
  .social { color: var(--ink-soft); border: 0; display: inline-flex; transition: color .2s ease, transform .2s ease; }
  .social:hover { color: var(--gold); transform: translateY(-1px); }

  /* Dropdown de Atendimentos (desktop) */
  .nav-group { position: relative; }
  .nav-group-trigger { display: inline-flex; align-items: center; gap: .3em; }
  .nav-caret { transition: transform .25s var(--ease); opacity: .7; }
  .nav-group:hover .nav-caret, .nav-group:focus-within .nav-caret { transform: rotate(180deg); }
  .nav-submenu {
    position: absolute; top: 100%; left: -.6rem; min-width: 210px;
    display: flex; flex-direction: column; gap: 2px;
    margin-top: .5rem; padding: var(--s3);
    background: var(--paper); border: 1px solid var(--line); border-radius: 12px;
    box-shadow: var(--shadow-soft);
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity .2s var(--ease), transform .2s var(--ease), visibility .2s;
    z-index: 40;
  }
  /* ponte invisível para o hover não cair no vão entre gatilho e submenu */
  .nav-submenu::before { content: ''; position: absolute; top: -.6rem; left: 0; right: 0; height: .6rem; }
  .nav-group:hover .nav-submenu, .nav-group:focus-within .nav-submenu {
    opacity: 1; visibility: visible; transform: translateY(0);
  }
  .nav-sublink { padding: var(--s2) var(--s3); border-radius: 8px; white-space: nowrap; }
  .nav-sublink::after { display: none; }
  .nav-sublink:hover { background: var(--paper-2); color: var(--ink); }

  .nav-arcano { color: var(--gold); font-weight: 600; }
  .nav-arcano::after { background: var(--gold-soft); }
  .nav-cta { font-size: .92rem; padding: var(--s2) var(--s5); }

  .menu-toggle { display: none; }
  .nav-scrim { display: none; }

  @media (max-width: 860px) {
    /* Remove o backdrop-filter no mobile: ele cria containing-block e prendia o
       painel fixo do menu dentro da barra. Sem ele, o nav fixo cobre a viewport. */
    .site-header { -webkit-backdrop-filter: none; backdrop-filter: none; background: var(--paper); }
    .menu-toggle {
      display: inline-grid; place-items: center;
      width: 44px; height: 44px; padding: 0; color: var(--ink);
      background: transparent; border: 1px solid var(--line); border-radius: 10px; cursor: pointer;
    }
    .menu-toggle .i-close { display: none; }
    .menu-toggle[aria-expanded="true"] .i-menu { display: none; }
    .menu-toggle[aria-expanded="true"] .i-close { display: block; }

    nav {
      position: fixed; top: 0; right: 0; bottom: 0; left: auto;
      width: min(82vw, 320px); height: 100dvh;
      flex-direction: column; flex-wrap: nowrap; align-items: flex-start; justify-content: flex-start; gap: var(--s5);
      background: var(--paper); border-left: 1px solid var(--line);
      padding: calc(var(--s8) + var(--s6)) var(--s6) var(--s7);
      overflow-y: auto; -webkit-overflow-scrolling: touch;
      transform: translateX(100%); transition: transform .3s var(--ease);
      box-shadow: var(--shadow-soft);
      z-index: 50;
    }
    nav.open { transform: translateX(0); }
    /* Botão de fechar e véu de fundo aparecem quando o menu abre. */
    .menu-toggle { position: relative; z-index: 60; }
    .nav-pages { flex-direction: column; align-items: flex-start; gap: var(--s4); }
    .navlink { font-size: 1.15rem; }
    /* No drawer mobile o dropdown vira sublista indentada, sempre visível */
    .nav-group { width: 100%; display: flex; flex-direction: column; gap: var(--s3); }
    .nav-caret { display: none; }
    .nav-submenu {
      position: static; opacity: 1; visibility: visible; transform: none;
      flex-direction: column; gap: var(--s2);
      margin: 0; padding: 0 0 0 var(--s4); min-width: 0;
      background: transparent; border: 0; box-shadow: none;
      border-left: 1px solid var(--line);
    }
    .nav-submenu::before { display: none; }
    .nav-sublink { font-size: 1rem; color: var(--ink-soft); padding: 0; }
    .nav-sublink:hover { background: transparent; }
    .nav-social { gap: var(--s4); }
    .nav-cta { margin-top: var(--s3); width: 100%; justify-content: center; box-sizing: border-box; }
    .nav-scrim:not([hidden]) {
      display: block; position: fixed; inset: 0; z-index: 45;
      background: color-mix(in srgb, var(--ink) 42%, transparent);
      -webkit-backdrop-filter: blur(1px); backdrop-filter: blur(1px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand:hover .brand-mark { transform: none; }
    nav { transition: none; }
  }
</style>
<script>
  (() => {
    const btn = document.querySelector('.menu-toggle');
    const nav = document.getElementById('nav-principal');
    const scrim = document.querySelector('[data-nav-scrim]');
    if (!btn || !nav) return;
    const toggle = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
      nav.classList.toggle('open', open);
      if (scrim) (scrim as HTMLElement).hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
    };
    btn.addEventListener('click', () => toggle(!nav.classList.contains('open')));
    scrim?.addEventListener('click', () => toggle(false));
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') toggle(false); });
  })();
</script>
