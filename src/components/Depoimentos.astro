---
// Renderiza uma lista de depoimentos como cards no design system da marca.
// Recebe a lista já filtrada/ordenada pela página que usa o componente.
interface Depoimento {
  id: string;
  nome: string;
  fonte: string;
  nota: number;
  texto: string;
  destaque?: boolean;
}
interface Props {
  items: Depoimento[];
}
const { items } = Astro.props;
---
<ul class="depo-grid" role="list">
  {items.map((d) => (
    <li class="depo-card">
      <p class="stars" role="img" aria-label={`Avaliação ${d.nota} de 5`}>
        <span aria-hidden="true">{'★'.repeat(d.nota)}</span>
      </p>
      <blockquote class="depo-texto">{d.texto}</blockquote>
      <footer class="depo-meta">
        <cite class="depo-nome">{d.nome}</cite>
        <span class="badge">{d.fonte}</span>
      </footer>
    </li>
  ))}
</ul>
<style>
  .depo-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--s5);
  }
  .depo-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-left: 2px solid var(--gold);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: var(--s6) var(--s6) var(--s5);
    transition: border-color .25s ease, box-shadow .3s ease, transform .2s var(--ease);
  }
  .depo-card:hover { border-color: var(--gold-soft); box-shadow: var(--shadow-soft); transform: translateY(-3px); }
  .stars {
    margin: 0 0 var(--s4);
    color: var(--gold-soft);
    font-size: .95rem;
    letter-spacing: 4px;
    line-height: 1;
    font-variant-emoji: text;
  }
  .depo-texto {
    /* Texto em destaque: serifa literária, na voz de quem escreveu. */
    font-family: var(--font-serif);
    font-size: 1.18rem;
    line-height: 1.6;
    color: var(--ink);
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
  }
  .depo-texto::before { content: '“'; font-family: var(--font-display); color: var(--gold-soft); font-size: 1.4em; line-height: 0; vertical-align: -0.35em; margin-right: .05em; }
  .depo-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    margin-top: var(--s5);
    padding-top: var(--s4);
    border-top: 1px solid var(--line);
  }
  .depo-nome {
    font-style: normal;
    font-weight: 600;
    font-size: .98rem;
    color: var(--ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .depo-card:hover { transform: none; }
  }
</style>
