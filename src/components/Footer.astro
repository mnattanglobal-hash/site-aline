---
import { SITE } from '../site';
const year = new Date().getFullYear();
---
<footer class="site-footer anchor">
  <div class="wrap inner">
    <div class="col-brand">
      <p class="name">Aline Antunes</p>
      <p class="tagline">Maturidade e autonomia emocional. O Tarô como ferramenta de consciência, não adivinhação.</p>
      <div class="social">
        <a href={SITE.youtube} target="_blank" rel="noopener" aria-label="Canal no YouTube">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.11-2.13C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.39.52A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.11 2.13c1.89.52 9.39.52 9.39.52s7.5 0 9.39-.52a3 3 0 0 0 2.11-2.13A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg>
        </a>
        <a href={SITE.instagram} target="_blank" rel="noopener" aria-label="Perfil no Instagram">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 4.38a5.46 5.46 0 1 0 0 10.92 5.46 5.46 0 0 0 0-10.92Zm0 9a3.54 3.54 0 1 1 0-7.08 3.54 3.54 0 0 1 0 7.08Zm6.96-9.22a1.28 1.28 0 1 1-2.56 0 1.28 1.28 0 0 1 2.56 0Z"/></svg>
        </a>
      </div>
    </div>
    <nav aria-label="Rodapé" class="cols">
      <p class="col-title">Navegar</p>
      <a href="/sobre">Sobre</a>
      <a href="/atendimentos">Atendimentos</a>
      <a href="/cursos">Cursos</a>
      <a href="/blog">Blog</a>
      <a href="/contato">Contato</a>
    </nav>
    <nav aria-label="Mais" class="cols">
      <p class="col-title">Mais</p>
      <a href={SITE.arcanoApp} target="_blank" rel="noopener">Descubra seu Arcano</a>
      <a href={SITE.youtube} target="_blank" rel="noopener">YouTube</a>
      <a href={SITE.instagram} target="_blank" rel="noopener">Instagram</a>
    </nav>
  </div>
  <div class="wrap bottom">
    <span class="small">© {year} Aline Antunes. Todos os direitos reservados.</span>
    <span class="small credo">O tarô não vê o seu futuro. Ele te devolve a você mesma.</span>
  </div>
</footer>
<style>
  .site-footer { margin-top: var(--s10); padding-block: var(--s8) var(--s5); }
  .inner { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: var(--s7); }
  .col-brand { max-width: 38ch; }
  .name { font-family: var(--font-display); font-size: 1.35rem; margin: 0 0 var(--s3); color: #f4ecdd; }
  .name .sparkle { color: var(--gold-bright); }
  .tagline { font-size: .95rem; line-height: 1.6; color: color-mix(in srgb, var(--on-dark) 74%, transparent); margin: 0 0 var(--s4); }
  .social { display: flex; gap: var(--s4); }
  .social a { color: color-mix(in srgb, var(--on-dark) 80%, transparent); border: 0; display: inline-flex; transition: color .2s ease, transform .2s ease; }
  .social a:hover { color: var(--gold-bright); transform: translateY(-2px); }

  .cols { display: flex; flex-direction: column; gap: var(--s3); }
  .col-title { font-family: var(--font-sans); font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; color: var(--gold-bright); font-weight: 600; margin: 0 0 var(--s1); }
  .cols a { color: color-mix(in srgb, var(--on-dark) 82%, transparent); border: 0; font-size: .98rem; width: fit-content; }
  .cols a:hover { color: #fff; }

  .bottom { display: flex; align-items: center; justify-content: space-between; gap: var(--s4); flex-wrap: wrap; margin-top: var(--s8); padding-top: var(--s4); border-top: 1px solid color-mix(in srgb, var(--on-dark) 16%, transparent); }
  .small { font-size: .85rem; color: color-mix(in srgb, var(--on-dark) 60%, transparent); }
  .credo { font-family: var(--font-serif); font-style: italic; color: var(--gold-bright); }

  @media (max-width: 720px) {
    .inner { grid-template-columns: 1fr 1fr; gap: var(--s6); }
    .col-brand { grid-column: 1 / -1; }
    .bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
