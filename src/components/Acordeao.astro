---
// FAQ em acordeão: clica na pergunta → revela a resposta (réplica do "dúvidas comuns").
// Acessível por padrão (<details>/<summary>, navegável por teclado).
// Opcional: um GIF ao lado (esquerda ou direita), conforme o feedback da Aline.
interface Item {
  q: string;
  a: string; // pode conter HTML (ex.: link do WhatsApp)
}
interface Props {
  items: Item[];
  gifSrc?: string;
  gifAlt?: string;
  gifSide?: 'left' | 'right';
  gifSize?: number; // largura do gif em px (padrão 200)
}
const { items, gifSrc, gifAlt = '', gifSide = 'left', gifSize = 200 } = Astro.props;
---
<div class:list={["acc-wrap", { "has-gif": !!gifSrc, "gif-right": gifSide === 'right' }]} style={`--gif-w:${gifSize}px`}>
  {gifSrc && (
    <figure class="acc-gif" aria-hidden="true">
      <img src={gifSrc} alt={gifAlt} width={gifSize} height={Math.round(gifSize / 1.408)} loading="lazy" decoding="async" />
    </figure>
  )}
  <div class="acc-list">
    {items.map((it, i) => (
      <details class="acc-item" open={i === 0}>
        <summary class="acc-q">
          <span set:html={it.q}></span>
          <span class="acc-ico" aria-hidden="true"></span>
        </summary>
        <div class="acc-a"><p set:html={it.a}></p></div>
      </details>
    ))}
  </div>
</div>
<style>
  .acc-wrap { margin-top: var(--s6); }
  .acc-wrap.has-gif {
    display: grid; grid-template-columns: var(--gif-w, 200px) 1fr; gap: var(--s7); align-items: start;
  }
  .acc-wrap.has-gif.gif-right { grid-template-columns: 1fr var(--gif-w, 200px); }
  .acc-wrap.has-gif.gif-right .acc-gif { order: 2; }
  .acc-gif { margin: 0; position: sticky; top: var(--s7); }
  .acc-gif img { width: 100%; max-width: var(--gif-w, 200px); height: auto; mix-blend-mode: multiply; }

  .acc-list { display: grid; gap: var(--s3); }
  .acc-item {
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    background: color-mix(in srgb, #fff 70%, transparent);
    overflow: hidden;
  }
  .acc-q {
    list-style: none; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between; gap: var(--s4);
    padding: var(--s5) var(--s6);
    font-family: var(--font-display); font-weight: 600; font-size: 1.12rem;
    color: var(--ink); line-height: 1.35;
  }
  .acc-q::-webkit-details-marker { display: none; }
  .acc-q:hover { color: var(--gold); }
  .acc-ico { flex: none; position: relative; width: 16px; height: 16px; }
  .acc-ico::before, .acc-ico::after {
    content: ''; position: absolute; background: var(--terra); border-radius: 2px;
    transition: transform .25s var(--ease), opacity .2s ease;
  }
  .acc-ico::before { left: 0; top: 7px; width: 16px; height: 2px; }
  .acc-ico::after  { left: 7px; top: 0; width: 2px; height: 16px; }
  .acc-item[open] .acc-ico::after { transform: scaleY(0); opacity: 0; }
  .acc-a {
    padding: 0 var(--s6) var(--s5);
    font-family: var(--font-serif); font-size: 1.08rem; line-height: 1.6; color: var(--ink-soft);
  }
  .acc-a p { margin: 0; }
  .acc-a :global(a) { color: var(--gold); border-bottom: 1px solid var(--gold-soft); }
  .acc-a :global(a:hover) { color: var(--ink); border-color: var(--ink); }

  @media (max-width: 720px) {
    .acc-wrap.has-gif, .acc-wrap.has-gif.gif-right { grid-template-columns: 1fr; }
    .acc-gif { order: -1 !important; justify-self: center; }
    .acc-gif img { max-width: 140px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .acc-ico::before, .acc-ico::after { transition: none; }
  }
</style>
